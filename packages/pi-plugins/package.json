{
  "name": "@nklisch/pi-plugins",
  "version": "0.5.0",
  "private": false,
  "description": "A small filesystem-first marketplace and plugin host for Pi.",
  "license": "MIT",
  "author": "Nathan Klisch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nklisch/pi-extensions.git",
    "directory": "packages/pi-plugins"
  },
  "bugs": {
    "url": "https://github.com/nklisch/pi-extensions/issues"
  },
  "homepage": "https://github.com/nklisch/pi-extensions/tree/main/packages/pi-plugins#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "plugin-manager",
    "claude-code",
    "codex",
    "mcp"
  ],
  "pi": {
    "extensions": [
      "./dist/pi/production-subagents-extension.js",
      "./dist/pi/extension.js"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pi": {
      "types": "./dist/pi/index.d.ts",
      "import": "./dist/pi/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node --run clean:dist",
    "clean:dist": "node -e \"import('node:fs/promises').then(fs => fs.rm('dist', { recursive: true, force: true }))\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "test:package": "npm run build && node test/compiled-package-import.mjs && node test/compiled-pi-package-import.mjs",
    "test": "npm run typecheck && npm run test:unit && npm run test:package"
  },
  "bundledDependencies": [
    "@nklisch/pi-subagents"
  ],
  "dependencies": {
    "@nklisch/pi-mcp-adapter": "2.21.0-nklisch.2",
    "@nklisch/pi-subagents": "18.1.0-nklisch.3",
    "jiti": "2.7.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.82.0",
    "@earendil-works/pi-tui": "0.82.0",
    "@types/node": "^24.0.0",
    "typescript": ">=7.0.0 <8",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "bundleDependencies": [
    "@nklisch/pi-subagents"
  ]
}
