    "@mozilla/readability": "^0.6.0",
    "@narumitw/pi-usage": "^0.28.0",
    "@nklisch/pi-background-tasks": "^0",
    "@nklisch/pi-clearance": "^0",
    "@nklisch/pi-conveniences": "^0",
    "@nklisch/pi-fff-compat": "^0",
    "@nklisch/pi-mcp-adapter": "2.20.1-nklisch.0",
