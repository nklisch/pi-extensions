    "pi-catppuccin-tui": "^0.1.3",
    "pi-tool-display": "^0.5.0",
    "pi-web-access": "^0.13.0",
    "semver": "7.8.1",
    "smol-toml": "^1.7.0",
    "turndown": "^7.2.0",
    "typebox": "^1.1.24",
    "unpdf": "^1.6.2",
    "yaml": "2.9.0",
