{
  "name": "@nklisch/pi-mcp-adapter",
  "version": "2.21.0-nklisch.1",
  "description": "Independently maintained MCP client for Pi with a programmatic source lifecycle",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./programmatic": {
      "types": "./dist/programmatic.d.ts",
      "import": "./dist/programmatic.js"
    }
  },
  "license": "MIT",
  "author": "Nico Bailon",
  "contributors": [
    "Nathan Klisch"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-mcp-adapter": "cli.js"
  },
  "scripts": {
    "clean:programmatic": "node -e \"import('node:fs/promises').then(fs => fs.rm('dist', { recursive: true, force: true }))\"",
    "build:programmatic": "npm run clean:programmatic && tsc -p tsconfig.build.json && node scripts/copy-build-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "node --import tsx __tests__/packed-package.ts",
    "test:host-conformance": "node qualification/run-plugin-host-conformance.mjs",
    "test:oauth": "PI_MCP_ADAPTER_TEST_AUTH_STORE=memory node --import tsx --test --test-concurrency=1 mcp-auth.test.ts mcp-auth-flow.test.ts mcp-callback-server.test.ts mcp-oauth-provider.test.ts",
    "test:oauth-provider": "PI_MCP_ADAPTER_TEST_AUTH_STORE=memory node --import tsx --test mcp-oauth-provider.test.ts",
    "test:conformance": "bash conformance/run.sh",
    "prepack": "npm run build:programmatic",
    "build": "npm run build:programmatic"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nklisch/pi-extensions.git",
    "directory": "packages/pi-mcp-adapter"
  },
  "keywords": [
    "pi-package",
    "pi",
    "mcp",
    "model-context-protocol",
    "ai",
    "coding-agent",
    "extension",
    "claude",
    "llm",
    "pi-extension"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "video": "https://github.com/nicobailon/pi-mcp-adapter/raw/refs/heads/main/pi-mcp.mp4"
  },
  "files": [
    "cli.js",
    "agent-dir.ts",
    "index.ts",
    "programmatic.ts",
    "programmatic-types.ts",
    "programmatic-runtime.ts",
    "programmatic-extension.ts",
    "programmatic-cache.ts",
    "error-signal.ts",
    "state.ts",
    "utils.ts",
    "abort.ts",
    "runtime-owner.ts",
    "tool-metadata.ts",
    "ts-shape.ts",
    "search-ranking.ts",
    "tool-approval.ts",
    "init.ts",
    "ui-session.ts",
    "proxy-modes.ts",
    "direct-tools.ts",
    "commands.ts",
    "prompts.ts",
    "onboarding-state.ts",
    "mcp-setup-panel.ts",
    "types.ts",
    "ui-stream-types.ts",
    "ui-tool-visibility.ts",
    "ui-app-bridge-helpers.ts",
    "config.ts",
    "server-manager.ts",
    "unix-socket-transport.ts",
    "json-schema-validator.ts",
    "session-recovery.ts",
    "sampling-handler.ts",
    "elicitation-handler.ts",
    "tool-registrar.ts",
    "tool-result-renderer.ts",
    "mcp-output-guard.ts",
    "mcp-code.ts",
    "mcp-script-worker.mjs",
    "mcp-probe.ts",
    "resource-tools.ts",
    "lifecycle.ts",
    "mcp-status.ts",
    "metadata-cache.ts",
    "host-html-template.ts",
    "ui-resource-handler.ts",
    "consent-manager.ts",
    "ui-server.ts",
    "glimpse-ui.ts",
    "npx-resolver.ts",
    "oauth-handler.ts",
    "mcp-auth.ts",
    "mcp-keyring-helper.cjs",
    "mcp-oauth-provider.ts",
    "mcp-callback-server.ts",
    "mcp-auth-flow.ts",
    "mcp-panel.ts",
    "panel-keys.ts",
    "mcp-trace.ts",
    "logger.ts",
    "errors.ts",
    "app-bridge.bundle.js",
    "dist",
    "banner.png",
    "skills",
    "README.md",
    "MAINTAINING.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/ext-apps": "^1.2.2",
    "@napi-rs/keyring": "^1.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cross-spawn": "^7.0.6",
    "open": "^10.2.0",
    "recheck": "^4.5.0",
    "smol-toml": "^1.7.1",
    "strip-json-comments": "^5.0.3",
    "typebox": "^1.1.24",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.82.0 <1",
    "@earendil-works/pi-coding-agent": ">=0.82.0 <1",
    "@earendil-works/pi-tui": ">=0.82.0 <1",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.82.0",
    "@earendil-works/pi-coding-agent": "0.82.0",
    "@earendil-works/pi-tui": "0.82.0",
    "@modelcontextprotocol/conformance": "0.1.16",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/bun": "^1.0.0",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "20.19.43",
    "@types/open": "^6.2.1",
    "loupe": "^3.0.0",
    "tsx": "^4.21.0",
    "typebox": "1.3.8",
    "typescript": "5.9.3",
    "vitest": "^3.0.0"
  },
  "private": false,
  "bugs": {
    "url": "https://github.com/nklisch/pi-extensions/issues"
  },
  "homepage": "https://github.com/nklisch/pi-extensions/tree/main/packages/pi-mcp-adapter#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
